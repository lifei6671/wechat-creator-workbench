{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "微信创作工作台",
  "version": "0.1.0",
  "identifier": "io.github.lifei6671.wechat-creator-workbench",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "微信创作工作台",
      "width": 1360,
      "height": 840,
      "minWidth": 1000,
      "minHeight": 640,
      "dragDropEnabled": false
    }],
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

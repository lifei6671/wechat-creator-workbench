{
  "name": "wechat-workbench-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/node.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "recovery:cloudflare": "node scripts/cloudflare-recovery.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:remote": "node --test tests/remote.test.mjs"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_SECRET": { "description": "Paste the 32-byte initialization secret generated for this workspace." }
    }
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "better-sqlite3": "13.2.0",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.0",
    "wrangler": "4.164.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechat-workbench-sync",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-06-22",
  "d1_databases": [
    { "binding": "DB", "database_name": "wechat-workbench-sync", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "wechat-workbench-sync-blobs" }
  ]
}
